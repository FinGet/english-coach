# Optional ElevenLabs recap narration. You can also export these globally.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Merriam-Webster US word recordings. Keys stay local; no TTS fallback for words.
MERRIAM_WEBSTER_DICTIONARY_KEY=
MERRIAM_WEBSTER_LEARNERS_KEY=

# Optional path to a local DeepFilterNet executable; otherwise uses PATH or the local Mac ARM cache.
DEEP_FILTER_BIN=

# Optional Azure Speech pronunciation assessment (en-US; prosody disabled).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Alternative to REGION: https://<resource>.cognitiveservices.azure.com/
AZURE_SPEECH_ENDPOINT=

# Optional standalone API audit (scripts/audit.mjs).
# An AI coding assistant can review the transcript itself without this key.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
